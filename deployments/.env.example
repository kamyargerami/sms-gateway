# Application time zone (api, workers and MySQL). Timestamps in API responses and
# logs are rendered in this zone.
TZ=Asia/Tehran

# API Configuration
API_PORT=8080

# MySQL Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=sms_db
MYSQL_USER=sms_user
MYSQL_PASSWORD=smspassword
MYSQL_PORT=3306

# Database connection pool
# Budget: API_DB_MAX_OPEN_CONNS + (WORKER_EXPRESS_REPLICAS + WORKER_BULK_REPLICAS) * WORKER_DB_MAX_OPEN_CONNS
# must stay below MYSQL_MAX_CONNECTIONS (here: 50 + 117*3 = 401 < 550).
MYSQL_MAX_CONNECTIONS=550
API_DATABASE_MAX_OPEN_CONNECTIONS=50
API_DATABASE_MAX_IDLE_CONNECTIONS=25
# Each worker processes messages strictly sequentially (one goroutine per
# partition), so it only ever needs 1 connection actively in flight; a small
# pool just avoids reconnect overhead. Keep this low -- it's multiplied by
# (WORKER_EXPRESS_REPLICAS + WORKER_BULK_REPLICAS) in the budget above, and at
# scale that's the term that dominates.
WORKER_DATABASE_MAX_OPEN_CONNECTIONS=3
WORKER_DATABASE_MAX_IDLE_CONNECTIONS=2
DATABASE_CONNECTION_MAX_LIFETIME=5m

# Redis Configuration
REDIS_PORT=6379

# Kafka & Zookeeper Configuration
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
# Sized for >=100M SMS/day (see ARCHITECTURE.md section 7 for the full derivation):
#   100,000,000 / 86400s ~= 1,157 msg/s average -> x1.5 peak margin ~= 1,736 msg/s
#   split 70% express / 30% bulk -> ~1,215 msg/s express, ~521 msg/s bulk
#   each worker handles ~15 msg/s (one goroutine per partition, ~65ms/message:
#   mock operator latency + one MySQL transaction) -> partitions = replicas below.
# Partition count == replica count on purpose: a replica beyond the partition
# count would sit idle (a Kafka partition is owned by exactly one consumer).
KAFKA_PARTITIONS_EXPRESS=50
KAFKA_PARTITIONS_BULK=30

# Worker Configuration
WORKER_EXPRESS_REPLICAS=50
WORKER_BULK_REPLICAS=30

# Business Logic
SMS_COST=10

# Delivery deadline for express SMS (OTPs). An express SMS still queued after
# created_at + EXPRESS_SMS_TTL is marked EXPIRED, not sent and not charged.
# Bulk SMS have no deadline.
EXPRESS_SMS_TTL=2m
