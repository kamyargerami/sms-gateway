# MySQL Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=sms_db
MYSQL_USER=sms_user
MYSQL_PASSWORD=smspassword
MYSQL_PORT=3306

# Database connection pool
# Budget: API_DB_MAX_OPEN_CONNS + (WORKER_EXPRESS_REPLICAS + WORKER_BULK_REPLICAS) * WORKER_DB_MAX_OPEN_CONNS
# must stay below MYSQL_MAX_CONNECTIONS (here: 50 + 7*10 = 120 < 200).
MYSQL_MAX_CONNECTIONS=200
API_DB_MAX_OPEN_CONNS=50
API_DB_MAX_IDLE_CONNS=25
# Each worker processes messages sequentially, so it needs only a few connections.
WORKER_DB_MAX_OPEN_CONNS=10
WORKER_DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis Configuration
REDIS_PORT=6379

# Kafka & Zookeeper Configuration
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
KAFKA_PARTITIONS_EXPRESS=5
KAFKA_PARTITIONS_BULK=3

# API Configuration
API_PORT=8080

# Worker Configuration
WORKER_EXPRESS_REPLICAS=5
WORKER_BULK_REPLICAS=2

# Business Logic
SMS_COST=10
